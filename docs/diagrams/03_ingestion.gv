digraph "03_ingestion" {
	bgcolor=white fontname=Arial fontsize=18 label="Dataset Ingestion Pipeline" labelloc=t nodesep=0.35 pad=0.25 rankdir=TB ranksep=0.45
	node [color="#315A7D" fillcolor="#EAF2F8" fontname=Arial fontsize=10 margin="0.12,0.08" shape=box style="rounded,filled"]
	edge [arrowsize=0.7 color="#526777" fontname=Arial fontsize=8]
	N0 [label="Five raw annual CSVs"]
	N1 [label="File integrity + SHA256"]
	N2 [label="Schema validation"]
	N3 [label="Attach year from filename"]
	N4 [label="Concatenate in year/order"]
	N5 [label="Immutable raw snapshot + inventory"]
	N0 -> N1
	N1 -> N2
	N2 -> N3
	N3 -> N4
	N4 -> N5
}
