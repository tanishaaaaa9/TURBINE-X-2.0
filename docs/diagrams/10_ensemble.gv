digraph "10_ensemble" {
	bgcolor=white fontname=Arial fontsize=18 label="Optional Ensemble Evaluation" labelloc=t nodesep=0.35 pad=0.25 rankdir=TB ranksep=0.45
	node [color="#315A7D" fillcolor="#EAF2F8" fontname=Arial fontsize=10 margin="0.12,0.08" shape=box style="rounded,filled"]
	edge [arrowsize=0.7 color="#526777" fontname=Arial fontsize=8]
	N0 [label="Out-of-fold predictions A"]
	N1 [label="Stacking meta-model"]
	N2 [label="Out-of-fold predictions B"]
	N3 [label="Validation comparison"]
	N4 [label="Best single model"]
	N5 [label="Keep only if robustly better"]
	N0 -> N1
	N2 -> N1
	N1 -> N3
	N4 -> N3
	N3 -> N5
}
